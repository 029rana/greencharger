tanggal = seq(tanggal_selesai + 1, by = "day", length.out = 30),
prediksi_kwh = round(prediksi_kwh, 2),
batas_bawah = round(prediksi_interval[, "lwr"], 2),
batas_atas = round(prediksi_interval[, "upr"], 2)
)
