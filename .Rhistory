softdrink <- read.csv("D:\\RANA\\PRAKTIKUM\\PRAK RANCOB\\softdrink.csv", header = TRUE)
softdrink
View(softdrink)
#rbind= fungsi untuk menggabungkan objek berdasarkan baris, sehingga u1 dan u2 menjadi satu b
softdrink.df <- data.frame(respon = c(softdrink$U1, softdrink$U2),
rbind(softdrink[,1:3], softdrink[,1:3]))
softdrink.df
#lapply= untuk mengaplikasikan suatu fungsi ke setiap anggota x
softdrink.df[,2:4]=lapply(softdrink.df[,2:4],factor)
hasil = aov(respon~A*B*C, data= softdrink.df)
summary(hasil)
