stasiun_tertinggi <- ringkasan_stasiun %>% filter(Total_Pendapatan_IDR == max(Total_Pendapatan_IDR))
stasiun_terendah <- ringkasan_stasiun %>% filter(Total_Pendapatan_IDR == min(Total_Pendapatan_IDR))
