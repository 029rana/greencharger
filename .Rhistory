library(kableExtra)
library(lubridate)
library(ggplot2)
library(scales)
set.seed(2026)
tarif_per_kwh <- 2466
biaya_admin <- 5000
daftar_stasiun <- c("Stasiun Sudirman","Stasiun Tuanku Tambusai","Stasiun Panam","Stasiun Duri","Stasiun Dumai")
tanggal_mulai <- as.Date(paste0(params$bulan_tahun,"-01"))
tanggal_selesai <- ceiling_date(tanggal_mulai,"month")-days(1)
deret_tanggal <- seq(tanggal_mulai,tanggal_selesai,by="day")
total_hari <- length(deret_tanggal)
n_transaksi <- length(daftar_stasiun)*total_hari*12
data_transaksi <- tibble(
id_transaksi = paste0("TX-",10000+1:n_transaksi),
stasiun = sample(daftar_stasiun,n_transaksi,replace=TRUE),
tanggal = sample(deret_tanggal,n_transaksi,replace=TRUE),
jam = round(rbeta(n_transaksi,5,3)*23)
) %>%
mutate(
waktu_transaksi = as.POSIXct(paste(tanggal,jam),format="%Y-%m-%d %H"),
konsumsi_kwh = pmax(rnorm(n_transaksi,35,8),5),
pendapatan = round(konsumsi_kwh*tarif_per_kwh+biaya_admin)
)
data_utilitas <- expand.grid(tanggal = deret_tanggal, stasiun = daftar_stasiun) %>%
as_tibble() %>%
mutate(utilitas_persen = round(rbeta(n(),7,3)*100,2))
jumlah_stasiun <- length(daftar_stasiun)
jumlah_transaksi <- nrow(data_transaksi)
total_energi <- sum(data_transaksi$konsumsi_kwh)
total_pendapatan <- sum(data_transaksi$pendapatan)
kpi_data <- tibble(
Metrik = c("Total Stasiun Aktif", "Total Transaksi", "Total Konsumsi Energi", "Total Pendapatan"),
Nilai = c(
jumlah_stasiun,
format(jumlah_transaksi, big.mark = "."),
paste0(format(round(total_energi, 0), big.mark = "."), " kWh"),
paste0("Rp ", format(round(total_pendapatan, 0), big.mark = "."))
)
)
kable(kpi_data, col.names = c("Metrik", "Nilai"), align = "c") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"), font_size = 14)
ringkasan_stasiun <- data_transaksi %>%
group_by(stasiun) %>%
summarise(
Total_Transaksi = n(),
Total_Konsumsi_kWh = round(sum(konsumsi_kwh), 2),
Total_Pendapatan_IDR = round(sum(pendapatan), 0),
Rata_Rata_kWh = round(mean(konsumsi_kwh), 2),
.groups = "drop"
) %>%
inner_join(
data_utilitas %>%
group_by(stasiun) %>%
summarise(
Rata_Rata_Utilitas = round(mean(utilitas_persen), 2),
Min_Utilitas = min(utilitas_persen),
Max_Utilitas = max(utilitas_persen),
.groups = "drop"
),
by = "stasiun"
)
kable(ringkasan_stasiun, digits = 2, caption = "Kinerja Operasional Per Stasiun") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
tren_harian <- data_transaksi %>%
group_by(tanggal,stasiun) %>%
summarise(energi_harian=sum(konsumsi_kwh),.groups="drop")
ggplot(tren_harian, aes(tanggal, energi_harian, color = stasiun)) +
geom_line(size = 1) +
labs(title = "Tren Konsumsi Energi Harian per Stasiun", subtitle = paste0("Periode: ", params$bulan_tahun), x = "Tanggal", y = "Total Konsumsi Energi (kWh)", color = "Stasiun") +
theme_minimal() + theme(legend.position = "bottom") + scale_color_brewer(palette = "Dark2")
ggplot(ringkasan_stasiun, aes(x = reorder(stasiun, -Total_Pendapatan_IDR), y = Total_Pendapatan_IDR)) +
geom_col(aes(fill = stasiun), show.legend = FALSE) +
geom_text(aes(label = format(Total_Pendapatan_IDR, big.mark = ".")), vjust = -0.5, size = 3.5) +
labs(title = "Total Pendapatan per Stasiun", subtitle = paste0("Periode: ", params$bulan_tahun), x = "Stasiun", y = "Total Pendapatan (IDR)") +
theme_minimal() + theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
scale_y_continuous(labels = scales::comma)
data_utilitas %>%
mutate(minggu = week(tanggal), hari = wday(tanggal, label = TRUE)) %>%
group_by(stasiun, minggu) %>%
summarise(rata_utilitas = mean(utilitas_persen), .groups = "drop") %>%
ggplot(aes(x = factor(minggu), y = stasiun, fill = rata_utilitas)) +
geom_tile() + geom_text(aes(label = round(rata_utilitas, 0)), size = 3) +
scale_fill_gradient(low = "lightyellow", high = "darkgreen", name = "Utilitas %") +
labs(title = "Heatmap Utilitas Mingguan per Stasiun", subtitle = paste0("Periode: ", params$bulan_tahun), x = "Minggu ke-", y = "Stasiun") +
theme_minimal()
tren_total_harian <- data_transaksi %>%
group_by(tanggal) %>%
summarise(total_kwh = sum(konsumsi_kwh), .groups = "drop") %>%
mutate(indeks_hari = 1:n())
model_linier <- lm(total_kwh ~ indeks_hari, data = tren_total_harian)
hari_depan <- tibble(indeks_hari = (total_hari + 1):(total_hari + 30))
prediksi_kwh <- predict(model_linier, newdata = hari_depan)
total_prediksi_depan <- sum(prediksi_kwh)
rata_rata_harian <- mean(prediksi_kwh)
prediksi_interval <- predict(model_linier, newdata = hari_depan, interval = "confidence")
total_prediksi_lower <- sum(prediksi_interval[, "lwr"])
total_prediksi_upper <- sum(prediksi_interval[, "upr"])
prediksi_tabel <- data.frame(
Periode = "Bulan Berikutnya",
Total_Prediksi_kWh = round(total_prediksi_depan, 0),
Rata_rata_Harian_kWh = round(rata_rata_harian, 2),
Batas_Bawah_95CI = round(total_prediksi_lower, 0),
Batas_Atas_95CI = round(total_prediksi_upper, 0)
)
kable(prediksi_tabel, caption = "Prediksi Permintaan Energi 30 Hari ke Depan", align = "c") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"), font_size = 14)
data_prediksi <- bind_rows(
tren_total_harian %>% mutate(tipe = "Historis"),
tibble(
tanggal = seq(tanggal_selesai + 1, by = "day", length.out = 30),
total_kwh = prediksi_kwh,
indeks_hari = (total_hari + 1):(total_hari + 30),
tipe = "Prediksi"
)
)
ggplot(data_prediksi, aes(x = tanggal, y = total_kwh, color = tipe)) +
geom_line(size = 1.2) + geom_point(size = 0.8, alpha = 0.6) +
geom_ribbon(data = data_prediksi %>% filter(tipe == "Prediksi"), aes(ymin = prediksi_interval[, "lwr"], ymax = prediksi_interval[, "upr"], fill = "CI 95%"), alpha = 0.2, color = NA) +
labs(title = "Prediksi Konsumsi Energi Harian", subtitle = paste0("Periode Prediksi: ", format(tanggal_selesai + 1, "%d %B"), " - ", format(tanggal_selesai + 30, "%d %B %Y")), x = "Tanggal", y = "Total Konsumsi Energi (kWh)", color = "Tipe", fill = "") +
theme_minimal() + theme(legend.position = "bottom") +
scale_color_manual(values = c("Historis" = "darkblue", "Prediksi" = "darkred")) +
scale_fill_manual(values = c("CI 95%" = "gray50"))
nama_file_csv <- paste0("Export_KPI_", params$bulan_tahun, ".csv")
write.csv(ringkasan_stasiun, nama_file_csv, row.names = FALSE)
data_export_prediksi <- data.frame(
tanggal = seq(tanggal_selesai + 1, by = "day", length.out = 30),
prediksi_kwh = round(prediksi_kwh, 2),
batas_bawah = round(prediksi_interval[, "lwr"], 2),
batas_atas = round(prediksi_interval[, "upr"], 2)
)
nama_file_prediksi <- paste0("Export_Prediksi_", params$bulan_tahun, ".csv")
write.csv(data_export_prediksi, nama_file_prediksi, row.names = FALSE)
stasiun_tertinggi <- ringkasan_stasiun %>% filter(Total_Pendapatan_IDR == max(Total_Pendapatan_IDR))
stasiun_terendah <- ringkasan_stasiun %>% filter(Total_Pendapatan_IDR == min(Total_Pendapatan_IDR))
rata_utilitas <- mean(ringkasan_stasiun$Rata_Rata_Utilitas)
# SET DIRECTORY UNTUK SAVE CSV
dir_save <- "D://RANA//PRAKTIKUM//PRAK KOMSTAT"
if(!dir.exists(dir_save)) {
dir.create(dir_save, recursive = TRUE)
}
# Export KPI per Stasiun
nama_file_csv <- paste0(dir_save, "/Export_KPI_", params$bulan_tahun, ".csv")
write.csv(ringkasan_stasiun, nama_file_csv, row.names = FALSE)
# Export Prediksi
data_export_prediksi <- data.frame(
tanggal = seq(tanggal_selesai + 1, by = "day", length.out = 30),
prediksi_kwh = round(prediksi_kwh, 2),
batas_bawah = round(prediksi_interval[, "lwr"], 2),
batas_atas = round(prediksi_interval[, "upr"], 2)
)
nama_file_prediksi <- paste0(dir_save, "/Export_Prediksi_", params$bulan_tahun, ".csv")
write.csv(data_export_prediksi, nama_file_prediksi, row.names = FALSE)
# Export Data Transaksi
nama_file_transaksi <- paste0(dir_save, "/Export_Transaksi_", params$bulan_tahun, ".csv")
write.csv(data_transaksi, nama_file_transaksi, row.names = FALSE)
# Tampilkan path file di report
cat("### File CSV yang berhasil diekspor:\n\n")
cat(paste0("1. **", nama_file_csv, "** - Data KPI per stasiun\n"))
cat(paste0("2. **", nama_file_prediksi, "** - Data prediksi harian\n"))
cat(paste0("3. **", nama_file_transaksi, "** - Data transaksi lengkap\n\n"))
cat(paste0("📁 Lokasi file: **", dir_save, "**"))
knitr::opts_chunk$set(echo = FALSE, message = FALSE, warning = FALSE, fig.width = 10, fig.height = 6)
library(tidyverse)
library(knitr)
library(kableExtra)
library(lubridate)
library(ggplot2)
library(scales)
set.seed(2026)
tarif_per_kwh <- 2466
biaya_admin <- 5000
# SET DIRECTORY UNTUK SAVE CSV DAN HTML
dir_save <- "D:/RANA/PRAKTIKUM/PRAK KOMSTAT"
if(!dir.exists(dir_save)) {
dir.create(dir_save, recursive = TRUE)
}
# SET WORKING DIRECTORY
setwd(dir_save)
daftar_stasiun <- c("Stasiun Sudirman","Stasiun Tuanku Tambusai","Stasiun Panam","Stasiun Duri","Stasiun Dumai")
tanggal_mulai <- as.Date(paste0(params$bulan_tahun,"-01"))
tanggal_selesai <- ceiling_date(tanggal_mulai,"month")-days(1)
deret_tanggal <- seq(tanggal_mulai,tanggal_selesai,by="day")
total_hari <- length(deret_tanggal)
n_transaksi <- length(daftar_stasiun)*total_hari*12
data_transaksi <- tibble(
id_transaksi = paste0("TX-",10000+1:n_transaksi),
stasiun = sample(daftar_stasiun,n_transaksi,replace=TRUE),
tanggal = sample(deret_tanggal,n_transaksi,replace=TRUE),
jam = round(rbeta(n_transaksi,5,3)*23)
) %>%
mutate(
waktu_transaksi = as.POSIXct(paste(tanggal,jam),format="%Y-%m-%d %H"),
konsumsi_kwh = pmax(rnorm(n_transaksi,35,8),5),
pendapatan = round(konsumsi_kwh*tarif_per_kwh+biaya_admin)
)
data_utilitas <- expand.grid(tanggal = deret_tanggal, stasiun = daftar_stasiun) %>%
as_tibble() %>%
mutate(utilitas_persen = round(rbeta(n(),7,3)*100,2))
jumlah_stasiun <- length(daftar_stasiun)
jumlah_transaksi <- nrow(data_transaksi)
total_energi <- sum(data_transaksi$konsumsi_kwh)
total_pendapatan <- sum(data_transaksi$pendapatan)
kpi_data <- tibble(
Metrik = c("Total Stasiun Aktif", "Total Transaksi", "Total Konsumsi Energi", "Total Pendapatan"),
Nilai = c(
jumlah_stasiun,
format(jumlah_transaksi, big.mark = "."),
paste0(format(round(total_energi, 0), big.mark = "."), " kWh"),
paste0("Rp ", format(round(total_pendapatan, 0), big.mark = "."))
)
)
kable(kpi_data, col.names = c("Metrik", "Nilai"), align = "c") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"), font_size = 14)
ringkasan_stasiun <- data_transaksi %>%
group_by(stasiun) %>%
summarise(
Total_Transaksi = n(),
Total_Konsumsi_kWh = round(sum(konsumsi_kwh), 2),
Total_Pendapatan_IDR = round(sum(pendapatan), 0),
Rata_Rata_kWh = round(mean(konsumsi_kwh), 2),
.groups = "drop"
) %>%
inner_join(
data_utilitas %>%
group_by(stasiun) %>%
summarise(
Rata_Rata_Utilitas = round(mean(utilitas_persen), 2),
Min_Utilitas = min(utilitas_persen),
Max_Utilitas = max(utilitas_persen),
.groups = "drop"
),
by = "stasiun"
)
kable(ringkasan_stasiun, digits = 2, caption = "Kinerja Operasional Per Stasiun") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
tren_harian <- data_transaksi %>%
group_by(tanggal,stasiun) %>%
summarise(energi_harian=sum(konsumsi_kwh),.groups="drop")
ggplot(tren_harian, aes(tanggal, energi_harian, color = stasiun)) +
geom_line(size = 1) +
labs(title = "Tren Konsumsi Energi Harian per Stasiun", subtitle = paste0("Periode: ", params$bulan_tahun), x = "Tanggal", y = "Total Konsumsi Energi (kWh)", color = "Stasiun") +
theme_minimal() + theme(legend.position = "bottom") + scale_color_brewer(palette = "Dark2")
ggplot(ringkasan_stasiun, aes(x = reorder(stasiun, -Total_Pendapatan_IDR), y = Total_Pendapatan_IDR)) +
geom_col(aes(fill = stasiun), show.legend = FALSE) +
geom_text(aes(label = format(Total_Pendapatan_IDR, big.mark = ".")), vjust = -0.5, size = 3.5) +
labs(title = "Total Pendapatan per Stasiun", subtitle = paste0("Periode: ", params$bulan_tahun), x = "Stasiun", y = "Total Pendapatan (IDR)") +
theme_minimal() + theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
scale_y_continuous(labels = scales::comma)
data_utilitas %>%
mutate(minggu = week(tanggal), hari = wday(tanggal, label = TRUE)) %>%
group_by(stasiun, minggu) %>%
summarise(rata_utilitas = mean(utilitas_persen), .groups = "drop") %>%
ggplot(aes(x = factor(minggu), y = stasiun, fill = rata_utilitas)) +
geom_tile() + geom_text(aes(label = round(rata_utilitas, 0)), size = 3) +
scale_fill_gradient(low = "lightyellow", high = "darkgreen", name = "Utilitas %") +
labs(title = "Heatmap Utilitas Mingguan per Stasiun", subtitle = paste0("Periode: ", params$bulan_tahun), x = "Minggu ke-", y = "Stasiun") +
theme_minimal()
tren_total_harian <- data_transaksi %>%
group_by(tanggal) %>%
summarise(total_kwh = sum(konsumsi_kwh), .groups = "drop") %>%
mutate(indeks_hari = 1:n())
model_linier <- lm(total_kwh ~ indeks_hari, data = tren_total_harian)
hari_depan <- tibble(indeks_hari = (total_hari + 1):(total_hari + 30))
prediksi_kwh <- predict(model_linier, newdata = hari_depan)
total_prediksi_depan <- sum(prediksi_kwh)
rata_rata_harian <- mean(prediksi_kwh)
prediksi_interval <- predict(model_linier, newdata = hari_depan, interval = "confidence")
total_prediksi_lower <- sum(prediksi_interval[, "lwr"])
total_prediksi_upper <- sum(prediksi_interval[, "upr"])
prediksi_tabel <- data.frame(
Periode = "Bulan Berikutnya",
Total_Prediksi_kWh = round(total_prediksi_depan, 0),
Rata_rata_Harian_kWh = round(rata_rata_harian, 2),
Batas_Bawah_95CI = round(total_prediksi_lower, 0),
Batas_Atas_95CI = round(total_prediksi_upper, 0)
)
kable(prediksi_tabel, caption = "Prediksi Permintaan Energi 30 Hari ke Depan", align = "c") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"), font_size = 14)
data_prediksi <- bind_rows(
tren_total_harian %>% mutate(tipe = "Historis"),
tibble(
tanggal = seq(tanggal_selesai + 1, by = "day", length.out = 30),
total_kwh = prediksi_kwh,
indeks_hari = (total_hari + 1):(total_hari + 30),
tipe = "Prediksi"
)
)
ggplot(data_prediksi, aes(x = tanggal, y = total_kwh, color = tipe)) +
geom_line(size = 1.2) + geom_point(size = 0.8, alpha = 0.6) +
geom_ribbon(data = data_prediksi %>% filter(tipe == "Prediksi"), aes(ymin = prediksi_interval[, "lwr"], ymax = prediksi_interval[, "upr"], fill = "CI 95%"), alpha = 0.2, color = NA) +
labs(title = "Prediksi Konsumsi Energi Harian", subtitle = paste0("Periode Prediksi: ", format(tanggal_selesai + 1, "%d %B"), " - ", format(tanggal_selesai + 30, "%d %B %Y")), x = "Tanggal", y = "Total Konsumsi Energi (kWh)", color = "Tipe", fill = "") +
theme_minimal() + theme(legend.position = "bottom") +
scale_color_manual(values = c("Historis" = "darkblue", "Prediksi" = "darkred")) +
scale_fill_manual(values = c("CI 95%" = "gray50"))
# SET DIRECTORY UNTUK SAVE CSV
dir_save <- "D:/RANA/PRAKTIKUM/PRAK KOMSTAT"
if(!dir.exists(dir_save)) {
dir.create(dir_save, recursive = TRUE)
}
# Export KPI per Stasiun
nama_file_csv <- paste0(dir_save, "/Export_KPI_", params$bulan_tahun, ".csv")
write.csv(ringkasan_stasiun, nama_file_csv, row.names = FALSE)
# Export Prediksi
data_export_prediksi <- data.frame(
tanggal = seq(tanggal_selesai + 1, by = "day", length.out = 30),
prediksi_kwh = round(prediksi_kwh, 2),
batas_bawah = round(prediksi_interval[, "lwr"], 2),
batas_atas = round(prediksi_interval[, "upr"], 2)
)
nama_file_prediksi <- paste0(dir_save, "/Export_Prediksi_", params$bulan_tahun, ".csv")
write.csv(data_export_prediksi, nama_file_prediksi, row.names = FALSE)
# Export Data Transaksi
nama_file_transaksi <- paste0(dir_save, "/Export_Transaksi_", params$bulan_tahun, ".csv")
write.csv(data_transaksi, nama_file_transaksi, row.names = FALSE)
# Tampilkan path file di report
cat("### File CSV yang berhasil diekspor:\n\n")
cat(paste0("1. **", nama_file_csv, "** - Data KPI per stasiun\n"))
cat(paste0("2. **", nama_file_prediksi, "** - Data prediksi harian\n"))
cat(paste0("3. **", nama_file_transaksi, "** - Data transaksi lengkap\n\n"))
cat(paste0("📁 Lokasi file: **", dir_save, "**"))
stasiun_tertinggi <- ringkasan_stasiun %>% filter(Total_Pendapatan_IDR == max(Total_Pendapatan_IDR))
stasiun_terendah <- ringkasan_stasiun %>% filter(Total_Pendapatan_IDR == min(Total_Pendapatan_IDR))
rata_utilitas <- mean(ringkasan_stasiun$Rata_Rata_Utilitas)
knitr::opts_chunk$set(echo = FALSE, message = FALSE, warning = FALSE, fig.width = 10, fig.height = 6)
library(tidyverse)
library(knitr)
library(kableExtra)
library(lubridate)
library(ggplot2)
library(scales)
set.seed(2026)
tarif_per_kwh <- 2466
biaya_admin <- 5000
# SET DIRECTORY UNTUK SAVE CSV
dir_save <- "D:/RANA/PRAKTIKUM/PRAK KOMSTAT"
if(!dir.exists(dir_save)) {
dir.create(dir_save, recursive = TRUE)
}
daftar_stasiun <- c("Stasiun Sudirman","Stasiun Tuanku Tambusai","Stasiun Panam","Stasiun Duri","Stasiun Dumai")
tanggal_mulai <- as.Date(paste0(params$bulan_tahun,"-01"))
tanggal_selesai <- ceiling_date(tanggal_mulai,"month")-days(1)
deret_tanggal <- seq(tanggal_mulai,tanggal_selesai,by="day")
total_hari <- length(deret_tanggal)
n_transaksi <- length(daftar_stasiun)*total_hari*12
data_transaksi <- tibble(
id_transaksi = paste0("TX-",10000+1:n_transaksi),
stasiun = sample(daftar_stasiun,n_transaksi,replace=TRUE),
tanggal = sample(deret_tanggal,n_transaksi,replace=TRUE),
jam = round(rbeta(n_transaksi,5,3)*23)
) %>%
mutate(
waktu_transaksi = as.POSIXct(paste(tanggal,jam),format="%Y-%m-%d %H"),
konsumsi_kwh = pmax(rnorm(n_transaksi,35,8),5),
pendapatan = round(konsumsi_kwh*tarif_per_kwh+biaya_admin)
)
data_utilitas <- expand.grid(tanggal = deret_tanggal, stasiun = daftar_stasiun) %>%
as_tibble() %>%
mutate(utilitas_persen = round(rbeta(n(),7,3)*100,2))
jumlah_stasiun <- length(daftar_stasiun)
jumlah_transaksi <- nrow(data_transaksi)
total_energi <- sum(data_transaksi$konsumsi_kwh)
total_pendapatan <- sum(data_transaksi$pendapatan)
kpi_data <- tibble(
Metrik = c("Total Stasiun Aktif", "Total Transaksi", "Total Konsumsi Energi", "Total Pendapatan"),
Nilai = c(
jumlah_stasiun,
format(jumlah_transaksi, big.mark = "."),
paste0(format(round(total_energi, 0), big.mark = "."), " kWh"),
paste0("Rp ", format(round(total_pendapatan, 0), big.mark = "."))
)
)
kable(kpi_data, col.names = c("Metrik", "Nilai"), align = "c") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"), font_size = 14)
ringkasan_stasiun <- data_transaksi %>%
group_by(stasiun) %>%
summarise(
Total_Transaksi = n(),
Total_Konsumsi_kWh = round(sum(konsumsi_kwh), 2),
Total_Pendapatan_IDR = round(sum(pendapatan), 0),
Rata_Rata_kWh = round(mean(konsumsi_kwh), 2),
.groups = "drop"
) %>%
inner_join(
data_utilitas %>%
group_by(stasiun) %>%
summarise(
Rata_Rata_Utilitas = round(mean(utilitas_persen), 2),
Min_Utilitas = min(utilitas_persen),
Max_Utilitas = max(utilitas_persen),
.groups = "drop"
),
by = "stasiun"
)
kable(ringkasan_stasiun, digits = 2, caption = "Kinerja Operasional Per Stasiun") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
tren_harian <- data_transaksi %>%
group_by(tanggal,stasiun) %>%
summarise(energi_harian=sum(konsumsi_kwh),.groups="drop")
ggplot(tren_harian, aes(tanggal, energi_harian, color = stasiun)) +
geom_line(size = 1) +
labs(title = "Tren Konsumsi Energi Harian per Stasiun", subtitle = paste0("Periode: ", params$bulan_tahun), x = "Tanggal", y = "Total Konsumsi Energi (kWh)", color = "Stasiun") +
theme_minimal() + theme(legend.position = "bottom") + scale_color_brewer(palette = "Dark2")
ggplot(ringkasan_stasiun, aes(x = reorder(stasiun, -Total_Pendapatan_IDR), y = Total_Pendapatan_IDR)) +
geom_col(aes(fill = stasiun), show.legend = FALSE) +
geom_text(aes(label = format(Total_Pendapatan_IDR, big.mark = ".")), vjust = -0.5, size = 3.5) +
labs(title = "Total Pendapatan per Stasiun", subtitle = paste0("Periode: ", params$bulan_tahun), x = "Stasiun", y = "Total Pendapatan (IDR)") +
theme_minimal() + theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
scale_y_continuous(labels = scales::comma)
data_utilitas %>%
mutate(minggu = week(tanggal), hari = wday(tanggal, label = TRUE)) %>%
group_by(stasiun, minggu) %>%
summarise(rata_utilitas = mean(utilitas_persen), .groups = "drop") %>%
ggplot(aes(x = factor(minggu), y = stasiun, fill = rata_utilitas)) +
geom_tile() + geom_text(aes(label = round(rata_utilitas, 0)), size = 3) +
scale_fill_gradient(low = "lightyellow", high = "darkgreen", name = "Utilitas %") +
labs(title = "Heatmap Utilitas Mingguan per Stasiun", subtitle = paste0("Periode: ", params$bulan_tahun), x = "Minggu ke-", y = "Stasiun") +
theme_minimal()
tren_total_harian <- data_transaksi %>%
group_by(tanggal) %>%
summarise(total_kwh = sum(konsumsi_kwh), .groups = "drop") %>%
mutate(indeks_hari = 1:n())
model_linier <- lm(total_kwh ~ indeks_hari, data = tren_total_harian)
hari_depan <- tibble(indeks_hari = (total_hari + 1):(total_hari + 30))
prediksi_kwh <- predict(model_linier, newdata = hari_depan)
total_prediksi_depan <- sum(prediksi_kwh)
rata_rata_harian <- mean(prediksi_kwh)
prediksi_interval <- predict(model_linier, newdata = hari_depan, interval = "confidence")
total_prediksi_lower <- sum(prediksi_interval[, "lwr"])
total_prediksi_upper <- sum(prediksi_interval[, "upr"])
prediksi_tabel <- data.frame(
Periode = "Bulan Berikutnya",
Total_Prediksi_kWh = round(total_prediksi_depan, 0),
Rata_rata_Harian_kWh = round(rata_rata_harian, 2),
Batas_Bawah_95CI = round(total_prediksi_lower, 0),
Batas_Atas_95CI = round(total_prediksi_upper, 0)
)
kable(prediksi_tabel, caption = "Prediksi Permintaan Energi 30 Hari ke Depan", align = "c") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"), font_size = 14)
data_prediksi <- bind_rows(
tren_total_harian %>% mutate(tipe = "Historis"),
tibble(
tanggal = seq(tanggal_selesai + 1, by = "day", length.out = 30),
total_kwh = prediksi_kwh,
indeks_hari = (total_hari + 1):(total_hari + 30),
tipe = "Prediksi"
)
)
ggplot(data_prediksi, aes(x = tanggal, y = total_kwh, color = tipe)) +
geom_line(size = 1.2) + geom_point(size = 0.8, alpha = 0.6) +
geom_ribbon(data = data_prediksi %>% filter(tipe == "Prediksi"), aes(ymin = prediksi_interval[, "lwr"], ymax = prediksi_interval[, "upr"], fill = "CI 95%"), alpha = 0.2, color = NA) +
labs(title = "Prediksi Konsumsi Energi Harian", subtitle = paste0("Periode Prediksi: ", format(tanggal_selesai + 1, "%d %B"), " - ", format(tanggal_selesai + 30, "%d %B %Y")), x = "Tanggal", y = "Total Konsumsi Energi (kWh)", color = "Tipe", fill = "") +
theme_minimal() + theme(legend.position = "bottom") +
scale_color_manual(values = c("Historis" = "darkblue", "Prediksi" = "darkred")) +
scale_fill_manual(values = c("CI 95%" = "gray50"))
